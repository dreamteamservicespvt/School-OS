# Copy this file to .env and change every value. Never commit .env.
# In production these come from the hosting provider's secret store
# (08-platform-security.md §3), never from a file in the repository.

# Passwords for the two database roles, used by `npm run db:setup`.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app

# The running app connects as school_os_app (cannot bypass the school walls).
DATABASE_URL=postgresql://school_os_app:change-me-app@localhost:5432/school_os
# Migrations run as school_os_owner.
MIGRATION_DATABASE_URL=postgresql://school_os_owner:change-me-owner@localhost:5432/school_os

# Key for the extra encryption of highly sensitive fields (Aadhaar, bank
# account, gateway keys). 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Password used only by `npm run db:seed` for the demo school's demo users.
# Real schools' users always set their own password from an invite link.
DEMO_PASSWORD=

# The address people open School OS at, used in Parent Links and webhook
# addresses, e.g. https://app.schoolos.in (no trailing slash).
APP_URL=http://localhost:3000

# Key that Parent Link tokens are worked out from (HMAC). 32 random bytes,
# base64, made like FIELD_ENCRYPTION_KEY. Changing it stops every existing
# Parent Link working, so set it once.
PARENT_LINK_SECRET=

# ---- Super Admin console (DREAM TEAM SERVICES only) ----
# When set, the console opens only on this host (e.g. console.schoolos.in);
# every other host gets "not found" for /console. Empty: any host (local work).
CONSOLE_HOST=
# DREAM TEAM's support number, put at the end of invites and notices.
CONSOLE_SUPPORT_PHONE=
# DREAM TEAM's own WhatsApp Cloud API and MSG91 SMS accounts for invites,
# codes and invoices. Unset: messages are written to the server log (test).
CONSOLE_WHATSAPP_PHONE_NUMBER_ID=
CONSOLE_WHATSAPP_ACCESS_TOKEN=
CONSOLE_WHATSAPP_LANGUAGE=en
# Approved template names, one per purpose: INVITE, RESET, CODE, INVOICE, NOTICE, TEAM_INVITE.
CONSOLE_WHATSAPP_TEMPLATE_INVITE=
CONSOLE_MSG91_AUTH_KEY=
CONSOLE_SMS_SENDER=
CONSOLE_SMS_DLT_ENTITY_ID=
# DLT template IDs, one per purpose, like the WhatsApp ones.
CONSOLE_SMS_TEMPLATE_INVITE=
# DREAM TEAM's own Razorpay account for platform invoices. Point Razorpay's
# webhook (event payment_link.paid) at APP_URL/api/v1/console/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The seller on DREAM TEAM's GST invoices.
DREAM_TEAM_LEGAL_NAME=
DREAM_TEAM_ADDRESS=
DREAM_TEAM_GSTIN=
DREAM_TEAM_STATE=Telangana
