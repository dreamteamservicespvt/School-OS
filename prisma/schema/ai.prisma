// The AI service layer (gap list G28; 00-global.md §2.1). Every request to the
// outside AI service is logged here: what for, by whom, the token counts, the
// estimated cost and how it ended. Never the request's or the answer's
// content, so the log holds no personal details.

/// AI Call: one request a school's person made to the AI service, metadata only.
model AiCall {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @map("school_id") @db.Uuid
  /// The AI feature switch it ran under, e.g. "ai-smart-import".
  feature          String
  /// What it was for, in the code's own fixed words, e.g. "Match import columns".
  purpose          String
  /// The User Login who asked; null for the software's own jobs.
  userLoginId      String?  @map("user_login_id") @db.Uuid
  model            String
  /// Whether the request went out to the AI service (it counts towards the daily limit).
  sent             Boolean  @default(false)
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  /// Estimated cost in whole paise, from the token counts.
  costPaise        BigInt   @default(0) @map("cost_paise")
  durationMs       Int      @default(0) @map("duration_ms")
  /// pending, ok, refused, failed or fallback.
  outcome          String   @default("pending")
  /// A short code for a request that did not end ok, e.g. "daily-limit", "restricted-data", "timeout".
  reason           String?
  /// How many details were hidden before it was sent (phones, numbers).
  masked           Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([schoolId, createdAt])
  @@map("ai_call")
}

/// Assistant Conversation: one person's talk with the School OS Assistant
/// (docs/assistant/plan.md). It keeps the conversation's language (set by the
/// first message, changed only when the person clearly switches), the last few
/// turns for follow-ups, and the one change prepared and not yet confirmed.
/// Only the person who started it can read it (checked in the code).
model AssistantConversation {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  userLoginId     String    @map("user_login_id") @db.Uuid
  /// en, te or hi.
  language        String    @default("en")
  /// A different language seen in the last message(s): { lang, count }.
  pendingLanguage Json?     @map("pending_language")
  /// The last few turns: what the person said, the tools used and the reply.
  turns           Json      @default("[]")
  /// The change prepared and not yet confirmed: { id, kind, plan, at }.
  prepared        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  @@index([schoolId, userLoginId, updatedAt])
  @@map("assistant_conversation")
}
