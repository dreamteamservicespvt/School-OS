// 11 Communication: messages and their recipients, templates, notices,
// queries, automatic message rules, opt-outs, the Parent Link and consent.
// Record names follow docs/blueprint/04-data-model.md (Area 6) and
// docs/blueprint/modules/11-communication.md §8.

enum MessageStatus {
  SCHEDULED
  QUEUED
  SENT
  CANCELLED
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NoticeStatus {
  DRAFT
  WAITING_APPROVAL
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NoticePriority {
  NORMAL
  HIGH
  CRITICAL
}

enum QueryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ParentLinkStatus {
  ACTIVE
  REVOKED
}

/// Template: a ready message format with blanks. Its text lives in versions, one per language.
model Template {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String
  /// fees, attendance, exam, general, admission, transport, homework, events, staff, parent-link.
  category    String
  /// whatsapp, sms, email or app.
  channel     String
  /// A fixed key used by automatic messages (e.g. "absence"), so a module finds its template.
  key         String?
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  versions TemplateVersion[]

  @@index([schoolId, channel, category])
  @@index([schoolId, key])
  @@map("template")
}

/// One saved version of a Template's text in one language. A save makes a new version; sent messages keep theirs.
model TemplateVersion {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  /// Language code: en, hi, te, ta, kn, ml, mr, bn.
  language       String
  version        Int
  isCurrent      Boolean  @default(true) @map("is_current")
  /// Title for email and app notifications.
  subject        String?
  body           String
  /// Blanks used in the body, e.g. ["student_name", "due_amount"].
  variables      String[] @default([])
  /// SMS: the DLT template ID registered on the telecom DLT portal (rule 34).
  dltTemplateId  String?  @map("dlt_template_id")
  /// WhatsApp: the name the template was submitted under, and its approval.
  whatsappName   String?  @map("whatsapp_name")
  /// NOT_SUBMITTED, PENDING, APPROVED, REJECTED.
  whatsappStatus String?  @map("whatsapp_status")
  whatsappNote   String?  @map("whatsapp_note")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id])

  @@unique([templateId, language, version])
  @@index([schoolId, templateId, isCurrent])
  @@map("template_version")
}

/// Message: one send to one person or many, on one or more channels.
model Message {
  id                String        @id @default(uuid()) @db.Uuid
  schoolId          String        @map("school_id") @db.Uuid
  title             String?
  /// The text as typed, or the template text with its blanks.
  body              String
  channels          String[]
  templateId        String?       @map("template_id") @db.Uuid
  /// Which audience was chosen, in words ("Parents of Class 5 A and 5 B") and as a rule.
  audienceLabel     String        @map("audience_label")
  audience          Json          @default("{}")
  recipientCount    Int           @default(0) @map("recipient_count")
  /// People left out and why: [{ reason, count, names }].
  skipped           Json          @default("[]")
  creditCost        Int           @default(0) @map("credit_cost")
  status            MessageStatus @default(QUEUED)
  isEmergency       Boolean       @default(false) @map("is_emergency")
  /// fee, attendance, result, general... (decides SMS backup); "one-time-code" for a code (never resent, ignores opt-outs).
  messageType       String        @default("general") @map("message_type")
  smsBackup         Boolean       @default(false) @map("sms_backup")
  /// The SMS template (with DLT template IDs) used for backup SMS.
  backupTemplateId  String?       @map("backup_template_id") @db.Uuid
  /// Sent by a person, or by an automatic rule.
  sentById          String?       @map("sent_by_id") @db.Uuid
  ruleKey           String?       @map("rule_key")
  /// What caused it, e.g. "Absent on 09-10-2026", "Notice: Diwali holidays".
  trigger           String?
  /// The record that asked for it: Notice, Query, Parent Link, Consent Request, Payment...
  sourceType        String?       @map("source_type")
  sourceId          String?       @map("source_id")
  /// Email and WhatsApp attachments (Stored File ids).
  attachmentFileIds String[]      @default([]) @map("attachment_file_ids") @db.Uuid
  /// A send that repeats another (retry, resend to unread).
  resendOfId        String?       @map("resend_of_id") @db.Uuid
  /// Makes a repeat of the same request a no-op.
  idempotencyKey    String?       @map("idempotency_key")
  scheduledAt       DateTime?     @map("scheduled_at")
  sentAt            DateTime?     @map("sent_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  recipients MessageRecipient[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, createdAt])
  @@index([schoolId, sourceType, sourceId])
  @@index([schoolId, status, scheduledAt])
  @@map("message")
}

/// Message Recipient: one person who gets one Message on one channel, with their own delivery status.
model MessageRecipient {
  id                String         @id @default(uuid()) @db.Uuid
  schoolId          String         @map("school_id") @db.Uuid
  messageId         String         @map("message_id") @db.Uuid
  /// guardian, student or staff.
  recipientType     String         @map("recipient_type")
  guardianId        String?        @map("guardian_id") @db.Uuid
  studentId         String?        @map("student_id") @db.Uuid
  staffId           String?        @map("staff_id") @db.Uuid
  userLoginId       String?        @map("user_login_id") @db.Uuid
  name              String
  /// What the person is to the school, e.g. "Father of Ravi, 5 A".
  description       String?
  channel           String
  /// Phone (10 digits), email, or the login for app messages.
  address           String
  language          String         @default("en")
  templateVersionId String?        @map("template_version_id") @db.Uuid
  /// Blanks filled for this person, kept for retries and SMS backup.
  values            Json           @default("{}")
  /// The exact text this person gets. A one-time code is kept as "••••••" (QA SEC-01).
  text              String
  /// A one-time code, encrypted, only until the delivery job hands it to the provider; then cleared (src/lib/messaging/one-time-code.ts).
  sealedCode        String?        @map("sealed_code")
  status            DeliveryStatus @default(QUEUED)
  failReason        String?        @map("fail_reason")
  providerMessageId String?        @map("provider_message_id")
  provider          String?
  credits           Int            @default(0)
  attempts          Int            @default(0)
  /// Sent again as SMS because this one failed or was not read in time.
  isBackup          Boolean        @default(false) @map("is_backup")
  backupOfId        String?        @unique @map("backup_of_id") @db.Uuid
  backupReason      String?        @map("backup_reason")
  /// [{ at, status, note }]
  history           Json           @default("[]")
  lockedAt          DateTime?      @map("locked_at")
  queuedAt          DateTime       @default(now()) @map("queued_at")
  sentAt            DateTime?      @map("sent_at")
  deliveredAt       DateTime?      @map("delivered_at")
  readAt            DateTime?      @map("read_at")
  failedAt          DateTime?      @map("failed_at")

  message Message @relation(fields: [messageId], references: [id])

  @@index([schoolId, messageId, status])
  @@index([schoolId, guardianId])
  @@index([schoolId, staffId])
  @@index([schoolId, userLoginId, channel])
  @@index([schoolId, providerMessageId])
  @@map("message_recipient")
}

/// Recipient Group: a saved set of recipients, e.g. "Class 10 parents" or "Sports team".
model RecipientGroup {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String
  /// The audience rule: { kinds, classIds, sectionIds, roleKeys, guardianIds, studentIds, staffIds }.
  rule        Json
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  @@unique([schoolId, name])
  @@map("recipient_group")
}

/// Automatic Message Rule: WHEN something happens THEN send a message. One row per rule the school has changed.
model AutomaticMessageRule {
  schoolId    String   @map("school_id") @db.Uuid
  key         String
  isOn        Boolean  @default(true) @map("is_on")
  templateId  String?  @map("template_id") @db.Uuid
  channels    String[] @default([])
  /// primary (main contact) or all guardians.
  sendTo      String   @default("primary") @map("send_to")
  /// Free settings for timing, e.g. { time: "07:30", daysBefore: 3 }.
  timing      Json     @default("{}")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([schoolId, key])
  @@map("automatic_message_rule")
}

/// Automation Log: what an automatic rule sent, to whom and why. One line per rule, event and person.
model AutomationLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  ruleKey       String   @map("rule_key")
  /// The event, e.g. "attendance:2026-10-09:<student id>".
  eventKey      String   @map("event_key")
  eventLabel    String   @map("event_label")
  /// guardian:<id>, staff:<id> or student:<id>.
  recipientKey  String   @map("recipient_key")
  recipientName String   @map("recipient_name")
  /// sent, rule-off, opted-out, no-credits, skipped.
  outcome       String
  note          String?
  messageId     String?  @map("message_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([schoolId, ruleKey, eventKey, recipientKey])
  @@index([schoolId, createdAt])
  @@map("automation_log")
}

/// Opt-out Record: a guardian stopped or restarted non-emergency messages.
model OptOutRecord {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  guardianId  String   @map("guardian_id") @db.Uuid
  /// opted-out or opted-in.
  action      String
  /// How: phone call, letter, WhatsApp reply "STOP", visit.
  how         String
  note        String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, guardianId])
  @@map("opt_out_record")
}

/// Message Settings: one row per school (automatic messages, SMS backup, retries, Parent Link...).
model MessageSettings {
  schoolId    String   @id @map("school_id") @db.Uuid
  settings    Json     @default("{}")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("message_settings")
}

/// Notice: a circular or notice for chosen roles, classes or campuses. Shown on Parent Link.
model Notice {
  id                String         @id @default(uuid()) @db.Uuid
  schoolId          String         @map("school_id") @db.Uuid
  title             String
  body              String
  attachmentFileIds String[]       @default([]) @map("attachment_file_ids") @db.Uuid
  /// { parents, students, staff, roleKeys, classIds, sectionIds, campusIds }.
  audience          Json
  audienceLabel     String         @map("audience_label")
  priority          NoticePriority @default(NORMAL)
  /// board, app, parent-link, whatsapp, sms, email.
  channels          String[]
  status            NoticeStatus   @default(DRAFT)
  publishAt         DateTime?      @map("publish_at")
  expiresOn         DateTime?      @map("expires_on") @db.Date
  askAck            Boolean        @default(false) @map("ask_ack")
  approvalId        String?        @map("approval_id") @db.Uuid
  publishedAt       DateTime?      @map("published_at")
  /// Staff and students with a login, and guardians, in the audience when published.
  staffCount        Int            @default(0) @map("staff_count")
  guardianCount     Int            @default(0) @map("guardian_count")
  /// The message that carried it to parents, if any.
  messageId         String?        @map("message_id") @db.Uuid
  createdById       String?        @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedById       String?        @map("updated_by_id") @db.Uuid
  updatedAt         DateTime       @updatedAt @map("updated_at")
  archivedAt        DateTime?      @map("archived_at")

  readers NoticeAcknowledgement[]
  seenBy  NoticeGuardianView[]

  @@index([schoolId, status, publishAt])
  @@map("notice")
}

/// Notice Acknowledgement: a staff member or student opened a notice, and tapped "I have read this".
model NoticeAcknowledgement {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  noticeId       String    @map("notice_id") @db.Uuid
  userLoginId    String    @map("user_login_id") @db.Uuid
  readAt         DateTime  @default(now()) @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  notice Notice @relation(fields: [noticeId], references: [id])

  @@unique([noticeId, userLoginId])
  @@map("notice_acknowledgement")
}

/// A guardian first saw a notice, on Parent Link or by a WhatsApp read receipt.
model NoticeGuardianView {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  noticeId    String   @map("notice_id") @db.Uuid
  guardianId  String   @map("guardian_id") @db.Uuid
  /// parent-link or whatsapp.
  via         String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  notice Notice @relation(fields: [noticeId], references: [id])

  @@unique([noticeId, guardianId])
  @@map("notice_guardian_view")
}

/// Query Topic: what a query is about (transport, food, teaching...), with its default owner.
model QueryTopic {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @map("school_id") @db.Uuid
  name                String
  defaultOwnerId      String?   @map("default_owner_id") @db.Uuid
  defaultDepartmentId String?   @map("default_department_id") @db.Uuid
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  archivedAt          DateTime? @map("archived_at")

  @@unique([schoolId, name])
  @@map("query_topic")
}

/// Query: a question, complaint, suggestion or feedback, with a ticket number, an owner and a status.
model Query {
  id             String      @id @default(uuid()) @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  number         String
  /// guardian, student, staff or other.
  fromType       String      @map("from_type")
  guardianId     String?     @map("guardian_id") @db.Uuid
  studentId      String?     @map("student_id") @db.Uuid
  staffId        String?     @map("staff_id") @db.Uuid
  fromName       String      @map("from_name")
  fromPhone      String?     @map("from_phone")
  aboutStudentId String?     @map("about_student_id") @db.Uuid
  /// query, complaint, suggestion, feedback.
  type           String
  topicId        String?     @map("topic_id") @db.Uuid
  details        String
  /// low, normal, high, urgent.
  priority       String      @default("normal")
  ownerId        String?     @map("owner_id") @db.Uuid
  departmentId   String?     @map("department_id") @db.Uuid
  /// phone, visit, whatsapp, email, letter.
  cameBy         String      @default("phone") @map("came_by")
  status         QueryStatus @default(OPEN)
  dueBy          DateTime?   @map("due_by")
  escalatedAt    DateTime?   @map("escalated_at")
  resolution     String?
  resolvedAt     DateTime?   @map("resolved_at")
  closedAt       DateTime?   @map("closed_at")
  rating         Int?
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  archivedAt     DateTime?   @map("archived_at")

  notes QueryNote[]

  @@unique([schoolId, number])
  @@index([schoolId, status])
  @@map("query")
}

/// Query Note: a reply to the requester, an internal note (never leaves the school), or a change.
model QueryNote {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  queryId     String   @map("query_id") @db.Uuid
  /// reply, internal or change.
  kind        String
  text        String
  messageId   String?  @map("message_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  query Query @relation(fields: [queryId], references: [id])

  @@index([schoolId, queryId])
  @@map("query_note")
}

/// Parent Link: one guardian's personal, secure link. Only the token's hash is kept (rule 31).
model ParentLink {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  guardianId   String           @map("guardian_id") @db.Uuid
  tokenHash    String           @unique @map("token_hash")
  /// The last 4 characters, to tell links apart on screen. The link is never shown in full.
  tokenHint    String           @map("token_hint")
  status       ParentLinkStatus @default(ACTIVE)
  lastOpenedAt DateTime?        @map("last_opened_at")
  lastSentAt   DateTime?        @map("last_sent_at")
  revokedAt    DateTime?        @map("revoked_at")
  revokedById  String?          @map("revoked_by_id") @db.Uuid
  revokeReason String?          @map("revoke_reason")
  replacedById String?          @map("replaced_by_id") @db.Uuid
  createdById  String?          @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  devices ParentLinkDevice[]
  codes   ParentLinkCode[]

  @@index([schoolId, guardianId])
  @@map("parent_link")
}

/// A phone a Parent Link was confirmed on with a one-time code. The browser keeps a random key; only its hash is kept.
model ParentLinkDevice {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  parentLinkId String    @map("parent_link_id") @db.Uuid
  keyHash      String    @unique @map("key_hash")
  /// A short description of the phone, e.g. "Android phone, Chrome".
  label        String
  ipAddress    String?   @map("ip_address")
  verifiedAt   DateTime  @default(now()) @map("verified_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")

  parentLink ParentLink @relation(fields: [parentLinkId], references: [id])

  @@index([schoolId, parentLinkId])
  @@map("parent_link_device")
}

/// A one-time code sent to the guardian's registered mobile, to confirm a new phone or a consent.
model ParentLinkCode {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  parentLinkId String    @map("parent_link_id") @db.Uuid
  /// device or consent.
  purpose      String
  codeHash     String    @map("code_hash")
  /// For consent: { consentTextId, studentIds, action }.
  detail       Json      @default("{}")
  /// The waiting browser's key hash, so only that phone can use the code.
  keyHash      String?   @map("key_hash")
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  messageId    String?   @map("message_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  parentLink ParentLink @relation(fields: [parentLinkId], references: [id])

  @@index([schoolId, parentLinkId, createdAt])
  @@map("parent_link_code")
}

/// Consent Record: one guardian's consent for one child for one consent type, with the text version agreed to (rule 33).
model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  guardianId    String    @map("guardian_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  consentType   String    @map("consent_type")
  consentTextId String    @map("consent_text_id") @db.Uuid
  textVersion   Int       @map("text_version")
  givenAt       DateTime  @default(now()) @map("given_at")
  /// admission-form, parent-link, office or paper-form (a signed paper form the office recorded; gap list G42).
  how           String
  parentLinkId  String?   @map("parent_link_id") @db.Uuid
  withdrawnAt   DateTime? @map("withdrawn_at")
  withdrawnHow  String?   @map("withdrawn_how")
  /// The guardian said no on a paper form: kept as an answer, never a consent (withdrawnAt is the same day, so it never stands).
  refused       Boolean   @default(false)
  createdById   String?   @map("created_by_id") @db.Uuid
  /// When the record was made (empty for records made before 23 October 2026). For a paper form, givenAt is the date on the form.
  createdAt     DateTime? @default(now()) @map("created_at")
  /// Undo of a paper-form import: the record is kept, archived, and no longer counts.
  archivedAt    DateTime? @map("archived_at")

  @@index([schoolId, guardianId, consentType])
  @@index([schoolId, studentId, consentType])
  @@map("consent_record")
}

/// Consent Request: one consent form sent to a set of guardians, with a reply-by date.
model ConsentRequest {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  consentType    String    @map("consent_type")
  consentTextId  String    @map("consent_text_id") @db.Uuid
  audienceLabel  String    @map("audience_label")
  /// Guardian ids asked.
  guardianIds    String[]  @map("guardian_ids") @db.Uuid
  replyBy        DateTime  @map("reply_by") @db.Date
  messageId      String?   @map("message_id") @db.Uuid
  lastReminderAt DateTime? @map("last_reminder_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, consentType])
  @@map("consent_request")
}

/// WhatsApp Conversation: one chat with one phone number on the school's WhatsApp Business number
/// (WhatsApp Inbox, an optional page). Matched to a parent or staff member when the number is known.
model WhatsappChat {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  /// 10-digit Indian mobile, or the full number for others.
  phone         String
  /// guardian, staff or unknown.
  contactType   String    @default("unknown") @map("contact_type")
  contactId     String?   @map("contact_id") @db.Uuid
  /// The name shown: the matched person, the WhatsApp profile name, or the number.
  displayName   String    @map("display_name")
  assignedToId  String?   @map("assigned_to_id") @db.Uuid
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  /// WhatsApp allows free text only within 24 hours of the person's last message.
  lastInboundAt DateTime? @map("last_inbound_at")
  unreadCount   Int       @default(0) @map("unread_count")
  resolvedAt    DateTime? @map("resolved_at")
  queryId       String?   @map("query_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  archivedAt    DateTime? @map("archived_at")

  messages WhatsappChatMessage[]

  @@unique([schoolId, phone])
  @@index([schoolId, assignedToId, lastMessageAt])
  @@map("whatsapp_chat")
}

/// One message in a WhatsApp Conversation, in or out.
model WhatsappChatMessage {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  chatId            String   @map("chat_id") @db.Uuid
  /// in or out.
  direction         String
  body              String
  sentById          String?  @map("sent_by_id") @db.Uuid
  providerMessageId String?  @map("provider_message_id")
  /// out: SENT, DELIVERED, READ or FAILED.
  status            String?
  failReason        String?  @map("fail_reason")
  createdAt         DateTime @default(now()) @map("created_at")

  chat WhatsappChat @relation(fields: [chatId], references: [id])

  @@index([schoolId, chatId, createdAt])
  @@index([schoolId, providerMessageId])
  @@map("whatsapp_chat_message")
}

/// Survey (an optional page): short questions for parents or staff, each person answering once.
model Survey {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  number        String
  title         String
  /// parents or staff.
  audienceKind  String    @map("audience_kind")
  /// school, class:<id> or section:<id> for parents; school for staff.
  audienceValue String    @default("school") @map("audience_value")
  audienceLabel String    @map("audience_label")
  anonymous     Boolean   @default(false)
  /// DRAFT, OPEN or CLOSED.
  status        String    @default("DRAFT")
  closesOn      DateTime? @map("closes_on") @db.Date
  sentAt        DateTime? @map("sent_at")
  closedAt      DateTime? @map("closed_at")
  invitedCount  Int       @default(0) @map("invited_count")
  messageId     String?   @map("message_id") @db.Uuid
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  archivedAt    DateTime? @map("archived_at")

  questions SurveyQuestion[]
  invites   SurveyInvite[]
  responses SurveyResponse[]

  @@unique([schoolId, number])
  @@index([schoolId, status, createdAt])
  @@map("survey")
}

/// Survey Question: choice, rating (1 to 5), text or date.
model SurveyQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  surveyId  String   @map("survey_id") @db.Uuid
  sortOrder Int      @map("sort_order")
  kind      String
  text      String
  options   String[] @default([])
  required  Boolean  @default(true)

  survey Survey @relation(fields: [surveyId], references: [id])

  @@index([schoolId, surveyId])
  @@map("survey_question")
}

/// One person asked to answer a survey, with their own link (only its hash is kept).
model SurveyInvite {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  surveyId   String    @map("survey_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  /// guardian or staff.
  personType String    @map("person_type")
  personId   String    @map("person_id") @db.Uuid
  answeredAt DateTime? @map("answered_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  survey Survey @relation(fields: [surveyId], references: [id])

  @@unique([schoolId, tokenHash])
  @@unique([surveyId, personType, personId])
  @@map("survey_invite")
}

/// Survey Response: one person's answers. Anonymous surveys keep no link to the person.
model SurveyResponse {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  surveyId    String   @map("survey_id") @db.Uuid
  /// Empty for anonymous surveys.
  personType  String?  @map("person_type")
  personId    String?  @map("person_id") @db.Uuid
  /// { questionId: answer }
  answers     Json
  submittedAt DateTime @default(now()) @map("submitted_at")

  survey Survey @relation(fields: [surveyId], references: [id])

  @@index([schoolId, surveyId])
  @@map("survey_response")
}
