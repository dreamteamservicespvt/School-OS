// Settings (module 20), part B: two-step login, trusted devices, and the
// bank accounts a payment gateway splits fees into (08-platform-security.md §2, §7).

/// A one-time code sent after the password is right, for roles that need two-step login.
/// Belongs to a login, not a school: it is checked before a school is opened.
model TwoStepChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userLoginId String    @map("user_login_id") @db.Uuid
  /// Hash of the random token kept in the browser between the two steps.
  tokenHash   String    @unique @map("token_hash")
  /// Hash of the 6-digit code; the code itself is never stored.
  codeHash    String    @map("code_hash")
  /// "email", "sms" or "log" (development without email set up).
  channel     String
  /// Where it was sent, masked, e.g. "pr•••@gmail.com".
  sentTo      String    @map("sent_to")
  attempts    Int       @default(0)
  /// "sign-in" (after the password); "code-sign-in" (instead of the password) and
  /// "code-sign-in-second" (the second code on the other contact, for roles that need two-step login);
  /// or "phone" / "email" when the code confirms a new mobile number or email.
  purpose     String    @default("sign-in")
  /// The new mobile number or email being confirmed (purpose "phone" or "email").
  newValue    String?   @map("new_value")
  /// The school the person was signing in to (not a school record itself).
  schoolId    String?   @map("target_school_id") @db.Uuid
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userLoginId, createdAt])
  @@map("two_step_challenge")
}

/// A remembered device: after a right code it skips the code until the person signs out
/// there, signs out everywhere, or does not use it for 180 days (decided 22 October 2026).
model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userLoginId String    @map("user_login_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  userAgent   String?   @map("user_agent")
  /// The browser's own device id, hashed (as on Session), so signing that device out forgets it.
  deviceKey   String?   @map("device_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([userLoginId])
  @@index([userLoginId, deviceKey])
  @@map("trusted_device")
}

/// A school bank account set up with the gateway for split payments
/// (Razorpay Route), used when fees go into different bank accounts.
model GatewayLinkedAccount {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  gatewayAccountId String    @map("gateway_account_id") @db.Uuid
  /// The school's name for the account, e.g. "Trust account".
  label            String
  /// The Cash or Bank Account in Finance Management, once linked.
  bankAccountId    String?   @map("bank_account_id") @db.Uuid
  bankName         String    @map("bank_name")
  accountLast4     String    @map("account_last4")
  ifsc             String
  /// The gateway's id for the linked account, e.g. Razorpay "acc_XXXXXXXXXXXXXX".
  linkedAccountId  String    @map("linked_account_id")
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  @@unique([schoolId, gatewayAccountId, linkedAccountId])
  @@map("gateway_linked_account")
}

/// One finished backup of the whole database, written by scripts/backup.sh.
/// Holds no school data; each school sees the latest time in Settings.
model BackupRun {
  id              String    @id @default(uuid()) @db.Uuid
  /// "nightly" (full database copy) or "files".
  kind            String    @default("nightly")
  finishedAt      DateTime  @default(now()) @map("finished_at")
  /// Where it went, e.g. the bucket path, for DREAM TEAM.
  location        String?
  /// When a restore of this copy was proven on a test copy (monthly).
  restoreTestedAt DateTime? @map("restore_tested_at")

  @@index([finishedAt])
  @@map("backup_run")
}

/// Password Policy: the school's password and session rules (Settings, Users &
/// Permissions, "Password and session rules"; gap list G45). A school with no row
/// keeps the rules every school had before: 7 days without use on any device, no
/// longest sign-in.
model PasswordPolicy {
  schoolId            String   @id @map("school_id") @db.Uuid
  /// Signed out after this many minutes without use on a computer.
  idleMinutesComputer Int      @default(10080) @map("idle_minutes_computer")
  /// Signed out after this many minutes without use on a phone (the browser or the installed app).
  idleMinutesPhone    Int      @default(10080) @map("idle_minutes_phone")
  /// The longest one sign-in lasts, used or not, in minutes; null = no limit.
  maxSessionMinutes   Int?     @map("max_session_minutes")
  updatedById         String?  @map("updated_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("password_policy")
}
