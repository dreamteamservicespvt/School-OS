# Copy this file to .env and change every value. Never commit .env.
# In production these come from the hosting provider's secret store
# (08-platform-security.md §3), never from a file in the repository.

# Passwords for the two database roles, used by `npm run db:setup`.
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app

# The running app connects as school_os_app (cannot bypass the school walls).
DATABASE_URL=postgresql://school_os_app:change-me-app@localhost:5432/school_os
# Migrations run as school_os_owner.
MIGRATION_DATABASE_URL=postgresql://school_os_owner:change-me-owner@localhost:5432/school_os

# Key for the extra encryption of highly sensitive fields (Aadhaar, bank
# account, gateway keys). 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Password used only by `npm run db:seed` for the demo school's demo users.
# Real schools' users always set their own password from an invite link.
DEMO_PASSWORD=

# The address people open School OS at, used in Parent Links and webhook
# addresses, e.g. https://app.schoolos.in (no trailing slash).
APP_URL=http://localhost:3000

# Key that Parent Link tokens are worked out from (HMAC). 32 random bytes,
# base64, made like FIELD_ENCRYPTION_KEY. Changing it stops every existing
# Parent Link working, so set it once.
PARENT_LINK_SECRET=

# Key that file links, online admission status links and correction passes
# are signed with (HMAC). 32 random bytes, base64, made like
# FIELD_ENCRYPTION_KEY, and different from it. Without it the encryption key
# signs too, and the live server warns at start-up. Set it before the first
# school goes live: setting or changing it later stops the admission status
# links already sent to parents (file links last only 15 minutes).
FILE_LINK_SECRET=

# How many proxies (load balancer, CDN) sit in front of the app and add to
# X-Forwarded-For. Sign-in limits use the address the outermost one saw, so a
# visitor cannot dodge them by sending their own header. 0: no proxy.
TRUSTED_PROXY_HOPS=1

# ---- Super Admin console (DREAM TEAM SERVICES only) ----
# When set, the console opens only on this host (e.g. console.schoolos.in);
# every other host gets "not found" for /console. Empty: any host (local work).
CONSOLE_HOST=
# DREAM TEAM's support number, put at the end of invites and notices.
CONSOLE_SUPPORT_PHONE=
# DREAM TEAM's own WhatsApp Cloud API and MSG91 SMS accounts for invites,
# codes and invoices. Unset: messages are written to the server log (test).
CONSOLE_WHATSAPP_PHONE_NUMBER_ID=
CONSOLE_WHATSAPP_ACCESS_TOKEN=
CONSOLE_WHATSAPP_LANGUAGE=en
# Approved template names, one per purpose: INVITE, RESET, CODE, INVOICE, NOTICE, TEAM_INVITE.
CONSOLE_WHATSAPP_TEMPLATE_INVITE=
CONSOLE_MSG91_AUTH_KEY=
CONSOLE_SMS_SENDER=
CONSOLE_SMS_DLT_ENTITY_ID=
# DLT template IDs, one per purpose, like the WhatsApp ones.
CONSOLE_SMS_TEMPLATE_INVITE=
# DREAM TEAM's own Razorpay account for platform invoices. Point Razorpay's
# webhook (event payment_link.paid) at APP_URL/api/v1/console/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The seller on DREAM TEAM's GST invoices.
DREAM_TEAM_LEGAL_NAME=
DREAM_TEAM_ADDRESS=
DREAM_TEAM_GSTIN=
DREAM_TEAM_STATE=Telangana

# ---- WhatsApp (Meta Cloud API) ----
# Each school connects its own WhatsApp Business number in Settings, SMS,
# WhatsApp & Email (keys stored encrypted). This is the Graph API version
# every WhatsApp call uses. Meta retires each version after about two years.
WHATSAPP_GRAPH_API_VERSION=v23.0

# ---- Push alerts (Firebase Cloud Messaging), 00-global.md §4 rules 6 and 8 ----
# All empty: push alerts are not offered. A school must also switch on
# "Push alerts" in Communication, Message Settings.
# The service account that sends pushes (Firebase console, Project settings,
# Service accounts, Generate new private key). Server only, never in a browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The "private_key" from that JSON file, on one line with \n kept as written.
FIREBASE_PRIVATE_KEY=
# The Firebase web app (Project settings, General, Your apps). Given to the
# browser only to get its push address.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Optional: Cloud Messaging, Web Push certificates, the public "Key pair".
# Empty: Firebase's default key is used.
FIREBASE_WEB_VAPID_KEY=

# ---- DREAM TEAM's first console Owner login (scripts/console-owner.ts) ----
# Added once by `npm run console:owner` or the Vercel build; never changed
# afterwards. The password needs 8+ characters with a letter and a number.
# Remove CONSOLE_OWNER_PASSWORD once you have signed in.
CONSOLE_OWNER_NAME=
CONSOLE_OWNER_PHONE=
CONSOLE_OWNER_EMAIL=
CONSOLE_OWNER_PASSWORD=

# ---- File storage ----
# Empty S3_BUCKET: files go to STORAGE_DIR on this computer's disk. Any
# S3-compatible store works: AWS S3 in Mumbai (ap-south-1), or Cloudflare R2
# with S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Background work without a worker ----
# "on": run due jobs right after the request that queued them (the Vercel
# test copy does this by itself). Leave empty when `npm run worker` runs.
RUN_JOBS_AFTER_REQUESTS=
